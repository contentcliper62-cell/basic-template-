{
  "description": "Blocks obviously destructive shell commands before they run.",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/scripts/block-dangerous.py\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
